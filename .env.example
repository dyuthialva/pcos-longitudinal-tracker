# ==============================================================================
# PCOS Longitudinal Tracker - Environment Configuration
# ==============================================================================

# Frontend API base URL (Point to FastAPI backend)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Database (SQLite by default, easily swapped with postgresql://...)
DATABASE_URL=sqlite:///./backend/pcos_tracker.db

# Groq API Configuration for LLM extraction and clinical reasoning
# Get your free-tier key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
