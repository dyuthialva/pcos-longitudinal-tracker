# =============================================================================
# PCOS Longitudinal Tracker - .gitignore
# Exclude build artifacts, local secrets, database files, and caches
# =============================================================================

# --- Environment & Secret Variables ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Database Files ---
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# --- Node / Frontend Artifacts ---
node_modules/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm

# --- Logs ---
logs/
*.log

# --- IDEs & Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.sw[op]
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Antigravity / Temporary Media Cache ---
.tempmediaStorage/
scratch/
